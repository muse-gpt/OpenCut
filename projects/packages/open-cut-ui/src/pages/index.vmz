<template>
    <div class="wb">
        <header class="wb-top">
            <div class="brand">OpenCut<span>审看工作台</span></div>
            <div class="meta" v-if="session">
                <strong>{{ session.name }}</strong>
                <span class="dim mono">{{ session.entry }}</span>
                <span class="pill">{{ session.project.width }}x{{ session.project.height }} · {{ session.project.fps }}fps</span>
                <span class="pill">{{ session.project.durationFrames }} 帧</span>
                <span class="pill mono">rev {{ session.revision }}</span>
            </div>
            <div class="spacer"></div>
            <span :class="bridgeReady ? 'status' : 'status bad'">{{ statusText }}</span>
        </header>

        <div class="banner" v-if="!bridgeReady">
            原生桥不可用。这个页面只在 <code>open-cut gui &lt;film&gt;</code> 打开的 WAE WebView 中工作；
            浏览器里不会加载假项目或假帧。
        </div>

        <main class="wb-body">
            <aside class="rail">
                <h2>场景</h2>
                <button
                    v-for="scene in scenes"
                    :key="scene.id"
                    type="button"
                    class="scene"
                    :data-id="scene.id"
                    @click="pickScene"
                >
                    <span class="scene-name">{{ scene.id }}</span>
                    <span class="scene-range mono">{{ scene.range[0] }}–{{ scene.range[1] }}</span>
                </button>
                <p class="rail-empty" v-if="session && !scenes.length">工程没有声明场景。</p>
                <p class="rail-empty" v-if="!session">正在读取工程…</p>

                <h2 v-if="session">镜头</h2>
                <div class="shot" v-for="shot in shots" :key="shot.id">
                    <button type="button" class="shot-head" :data-shot="shot.id" @click="pickShot">
                        <span class="shot-name">{{ shot.id }}<span class="lock" v-if="shot.locked">锁</span></span>
                        <span class="scene-range mono" v-if="shot.range">{{ shot.range[0] }}–{{ shot.range[1] }}</span>
                        <span class="scene-range mono bad" v-else>缺少场景</span>
                    </button>
                    <button
                        type="button"
                        class="panel"
                        v-for="panel in shot.panels"
                        :key="panel.id"
                        :data-shot="shot.id"
                        :data-panel="panel.id"
                        @click="pickPanel"
                    >
                        <span>{{ panel.id }}</span>
                        <span class="scene-range mono" v-if="panel.absolute">{{ panel.absolute[0] }}–{{ panel.absolute[1] }}</span>
                        <span class="scene-range mono bad" v-else>无区间</span>
                    </button>
                </div>
                <p class="rail-empty" v-if="session && !shots.length">生产册没有镜头。</p>

                <h2 v-if="session">生产册</h2>
                <dl class="counts" v-if="session">
                    <div><dt>镜头</dt><dd>{{ session.production.shots }}</dd></div>
                    <div><dt>面板</dt><dd>{{ session.production.panels }}</dd></div>
                    <div><dt>cue</dt><dd>{{ session.production.cues }}</dd></div>
                    <div><dt>素材</dt><dd>{{ session.production.assets }}</dd></div>
                </dl>

                <h2 v-if="session">宿主</h2>
                <dl class="counts" v-if="session">
                    <div><dt>native</dt><dd class="mono">{{ session.build.version }}</dd></div>
                    <div><dt>source</dt><dd class="mono">{{ session.build.sourceRev }}{{ session.build.dirty ? '*' : '' }}</dd></div>
                    <div><dt>profile</dt><dd class="mono">{{ session.build.profile }}</dd></div>
                </dl>
            </aside>

            <section class="stage">
                <div class="range-bar">
                    <label>起始帧
                        <input type="number" min="0" step="1" :value="startFrame" @input="onStartInput" />
                    </label>
                    <label>结束帧
                        <input type="number" min="0" step="1" :value="endFrame" @input="onEndInput" />
                    </label>
                    <label>预览缩放
                        <select @change="onScaleChange">
                            <option value="0.25" :selected="scale === 0.25">0.25x</option>
                            <option value="0.5" :selected="scale === 0.5">0.5x</option>
                            <option value="0.75" :selected="scale === 0.75">0.75x</option>
                            <option value="1" :selected="scale === 1">1x</option>
                        </select>
                    </label>
                    <button type="button" class="btn" @click="wholeFilm">整片</button>
                    <button type="button" class="btn primary" :disabled="!bridgeReady || rendering || !session" @click="renderRange">
                        {{ rendering ? '渲染中…' : '渲染区间' }}
                    </button>
                    <span class="hint mono" v-if="session">{{ rangeHint }}</span>
                </div>

                <div class="evidence" v-if="evidence">
                    <div class="evidence-head">
                        <strong>{{ evidence.shotId }}</strong>
                        <span class="pill mono">{{ evidence.panelId }}</span>
                        <span class="dim mono" v-if="evidence.range">{{ evidence.range[0] }}–{{ evidence.range[1] }} 帧</span>
                        <span class="spacer"></span>
                        <button type="button" class="btn" @click="playEvidence">渲染这段</button>
                    </div>
                    <dl class="evidence-fields">
                        <div><dt>必须看到</dt><dd :class="evidence.purpose ? '' : 'dim'">{{ evidence.purpose || '未写证据' }}</dd></div>
                        <div><dt>画面</dt><dd :class="evidence.composition ? '' : 'dim'">{{ evidence.composition || '未写构图' }}</dd></div>
                        <div v-if="evidence.dialogue"><dt>台词</dt><dd>{{ evidence.dialogue }}</dd></div>
                        <div v-if="evidence.camera"><dt>运镜</dt><dd>{{ evidence.camera }}</dd></div>
                        <div v-if="evidence.sound"><dt>声音</dt><dd>{{ evidence.sound }}</dd></div>
                        <div v-if="evidence.notes.length"><dt>备注</dt><dd>{{ evidence.notes.join(' · ') }}</dd></div>
                    </dl>
                    <div class="evidence-cues" v-if="evidence.cues.length">
                        <span class="dim">字幕</span>
                        <p class="mono" v-for="cue in evidence.cues" :key="cue.id">
                            {{ cue.absolute ? cue.absolute[0] + '–' + cue.absolute[1] : '?' }} {{ cue.text }}
                        </p>
                    </div>
                </div>

                <div class="result" v-if="result">
                    <div class="result-line">
                        <span class="ok">{{ resultCached ? '缓存命中' : '已渲染' }}</span>
                        <span class="mono">{{ resultSummary }}</span>
                    </div>
                    <div class="result-path mono">{{ resultPath }}</div>
                </div>

                <div class="viewer">
                    <video v-if="videoUrl" :src="videoUrl" controls autoplay loop></video>
                    <div v-else class="viewer-empty">
                        <p>选一段区间，然后点“渲染区间”。</p>
                        <p class="dim">GUI 通过 IPC 调用 native `previewRange`，产物是本机真实 MP4。</p>
                    </div>
                    <div class="progress" v-if="rendering">
                        <div class="progress-fill" :style="progressStyle"></div>
                    </div>
                </div>

                <div class="banner bad" v-if="error">{{ error }}</div>
            </section>
        </main>
    </div>
</template>

<style>
.wb {
    display: flex;
    flex-direction: column;
    width: 100%;
    height: 100vh;
    overflow: hidden;
}

.wb-top {
    display: flex;
    flex: 0 0 auto;
    align-items: center;
    gap: 14px;
    padding: 10px 16px;
    border-bottom: 1px solid var(--oc-line);
    background: var(--oc-surface);
}

.brand {
    font-weight: 700;
    letter-spacing: -0.01em;
}

.brand span {
    margin-left: 8px;
    color: var(--oc-muted);
    font-weight: 500;
    font-size: 12px;
}

.meta {
    display: flex;
    align-items: center;
    gap: 8px;
    min-width: 0;
    color: var(--oc-ink);
}

