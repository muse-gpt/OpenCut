    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
}

.scene-range {
    color: var(--oc-muted);
    font-size: 11px;
    white-space: nowrap;
}

.scene-range.bad {
    color: var(--oc-danger);
}

.shot {
    margin: 0 0 6px;
}

.shot-head,
.panel {
    display: flex;
    width: 100%;
    align-items: baseline;
    justify-content: space-between;
    gap: 8px;
    padding: 5px 8px;
    border: 1px solid transparent;
    border-radius: 6px;
    background: transparent;
    color: var(--oc-ink);
    text-align: left;
}

.shot-head:hover,
.panel:hover {
    border-color: var(--oc-line);
    background: var(--oc-surface-2);
}

.shot-name {
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
}

.lock {
    margin-left: 6px;
    padding: 0 4px;
    border: 1px solid var(--oc-line);
    border-radius: 4px;
    color: var(--oc-muted);
    font-size: 10px;
}

.panel {
    padding-left: 20px;
    color: var(--oc-muted);
    font-size: 12px;
}

.evidence {
    flex: 0 0 auto;
    padding: 8px 10px;
    border: 1px solid var(--oc-line);
    border-radius: 8px;
    background: var(--oc-surface);
}

.evidence-head {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: 8px;
}

.evidence-fields {
    display: grid;
    margin: 6px 0 0;
    gap: 2px;
}

.evidence-fields div {
    display: flex;
    gap: 10px;
}

.evidence-fields dt {
    flex: 0 0 4.5rem;
    color: var(--oc-muted);
}

.evidence-fields dd {
    margin: 0;
    min-width: 0;
    overflow-wrap: anywhere;
}

.evidence-cues {
    margin-top: 6px;
}

.evidence-cues p {
    margin: 2px 0 0;
    color: var(--oc-muted);
    font-size: 12px;
}

.rail-empty {
    margin: 0 0 4px;
    color: var(--oc-muted);
}

.counts {
    display: grid;
    margin: 0 0 4px;
    gap: 2px;
}

.counts div {
    display: flex;
    justify-content: space-between;
    gap: 8px;
}

.counts dt {
    color: var(--oc-muted);
}

.counts dd {
    margin: 0;
    max-width: 9rem;
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
}

.stage {
    display: flex;
    flex: 1 1 auto;
    min-width: 0;
    flex-direction: column;
    padding: 14px 16px 16px;
    gap: 12px;
}

.range-bar {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 10px;
}

.range-bar label {
    display: flex;
    align-items: center;
    gap: 6px;
    color: var(--oc-muted);
}

.range-bar input,
.range-bar select {
    width: 6.5rem;
    padding: 5px 8px;
    border: 1px solid var(--oc-line);
    border-radius: 6px;
    background: var(--oc-surface);
    color: var(--oc-ink);
    font: inherit;
}

.range-bar select {
    width: 5.5rem;
}

.btn {
    padding: 6px 12px;
    border: 1px solid var(--oc-line);
    border-radius: 6px;
    background: var(--oc-surface);
    color: var(--oc-ink);
}

.btn:hover:not(:disabled) {
    border-color: var(--oc-accent);
}

.btn.primary {
    border-color: var(--oc-accent);
    background: var(--oc-accent);
    color: var(--oc-accent-ink);
    font-weight: 600;
}

.btn.primary:disabled {
    opacity: 0.5;
}

.hint {
    color: var(--oc-muted);
    font-size: 12px;
}

.viewer {
    position: relative;
    display: flex;
    flex: 1 1 auto;
    min-height: 0;
    align-items: center;
    justify-content: center;
    border-radius: var(--oc-radius);
    background: var(--oc-stage);
    overflow: hidden;
}

.viewer video {
    width: 100%;
    height: 100%;
    object-fit: contain;
    background: var(--oc-stage);
}

.viewer-empty {
    padding: 24px;
    color: #c8d0dc;
    text-align: center;
}

.viewer-empty .dim {
    margin-top: 6px;
    color: #7d8896;
    font-size: 12px;
}

.progress {
    position: absolute;
    right: 0;
    bottom: 0;
    left: 0;
    height: 3px;
    background: rgba(255, 255, 255, 0.14);
}

.progress-fill {
    height: 100%;
    background: var(--oc-accent);
    transition: width 120ms linear;
}

.result {
    flex: 0 0 auto;
    padding: 8px 10px;
    border: 1px solid var(--oc-line);
    border-radius: 8px;
    background: var(--oc-surface);
}

.result-line {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: 10px;
}

.ok {
    color: #1e7a45;
    font-weight: 600;
}

.result-path {
    margin-top: 4px;
    color: var(--oc-muted);
    font-size: 11px;
    overflow-wrap: anywhere;
}
</style>

<script client>
export default class WorkbenchPage {
    bridgeReady = false;
    statusText = "等待原生桥";
    session = null;
    scenes = [];
    shots = [];
    cues = [];
    evidence = null;
    error = "";
    rendering = false;
    progressDone = 0;
    progressTotal = 0;
    videoUrl = "";
    result = null;
    resultCached = false;
    resultSummary = "";
    resultPath = "";
    rangeHint = "";
    progressStyle = "width: 0%";
    startFrame = 0;
    endFrame = 0;
    scale = 0.5;
    _webview = null;

    onMount() {
        const webview = globalThis.chrome && globalThis.chrome.webview;
        if (!webview || !webview.postMessage) {
            this.statusText = "原生桥不可用";
            return;
        }
        this._webview = webview;
        this.bridgeReady = true;
        this.statusText = "已连接原生宿主";
        if (webview.addEventListener) {
            webview.addEventListener("message", (event) => this.onHostMessage(event));
        }
        this.post({ type: "session" });
    }

    post(message) {
        if (!this._webview) return false;
        this._webview.postMessage(JSON.stringify(message));
        return true;
    }

    onHostMessage(event) {
        let data = event && event.data;
        if (typeof data === "string") {
            try {
                data = JSON.parse(data);
            }
            catch {
                return;
            }
        }
        if (!data || typeof data !== "object") return;
        if (data.type === "progress") {
            this.progressDone = Number(data.done) || 0;
            this.progressTotal = Number(data.total) || 0;
            const percent = this.progressTotal > 0 ? Math.min(100, Math.round((this.progressDone / this.progressTotal) * 100)) : 15;
            this.progressStyle = `width: ${percent}%`;
            return;
        }
        if (data.ok === false) {
            this.rendering = false;
            const error = data.error || {};
            this.error = `${error.code || "error"}: ${error.message || "unknown failure"}`;
            return;
        }
        if (data.ok === true) {
            this.applyResponse(data.data || {});
        }
    }

    applyResponse(data) {
        if (data.schema === "open-cut.session/v0") {
            this.session = data;
            this.scenes = Array.isArray(data.project.scenes) ? data.project.scenes : [];
            this.shots = data.production && Array.isArray(data.production.shotList) ? data.production.shotList : [];
            this.cues = data.production && Array.isArray(data.production.cueList) ? data.production.cueList : [];
            this.evidence = null;
            this.startFrame = 0;
            this.endFrame = data.project.durationFrames;
            this.scale = data.preview && data.preview.scale ? data.preview.scale : 0.5;
            this.statusText = "工程已载入";
            this.syncRange();
            const auto = data.preview && data.preview.autoPreview;
            if (auto) {
                this.startFrame = auto.startFrame;
                this.endFrame = auto.endFrame;
                this.syncRange();
                this.renderRange();
            }
            return;
        }
        if (typeof data.url === "string" && data.url.length > 0) {
            this.rendering = false;
            this.error = "";
            this.result = data;
            this.resultCached = data.cached === true;
            this.progressStyle = "width: 100%";
            this.resultPath = String(data.out || "");
            const seconds = (Number(data.frames) || 0) / (Number(data.fps) || 30);
            this.resultSummary = `${data.frames} 帧 · ${data.width}x${data.height} · ${seconds.toFixed(2)}s · ${this.formatBytes(data.bytes)}`;
            // The URL already carries the cache key, so a changed project is a
            // new URL and an unchanged one can stay browser-cached.
            this.videoUrl = data.url;
            this.statusText = this.resultCached ? "区间预览来自缓存" : "区间预览已就绪";
            return;
        }
        this.rendering = false;
        this.error = "宿主返回了无法识别的数据。";
    }

    syncRange() {
        const frames = Math.max(0, this.endFrame - this.startFrame);
        const fps = this.session ? this.session.project.fps : 30;
        this.rangeHint = `${frames} 帧 · ${(frames / fps).toFixed(2)}s`;
    }

    onStartInput(event) {
        this.startFrame = Number(event && event.target ? event.target.value : 0) || 0;
        this.syncRange();
    }

    onEndInput(event) {
        this.endFrame = Number(event && event.target ? event.target.value : 0) || 0;
        this.syncRange();
    }

    onScaleChange(event) {
        this.scale = Number(event && event.target ? event.target.value : 0.5) || 0.5;
    }

    pickScene(event) {
        const id = event && event.currentTarget && event.currentTarget.dataset ? event.currentTarget.dataset.id : "";
        const scene = this.scenes.find((item) => item.id === id);
        if (!scene) return;
        this.startFrame = scene.range[0];
        this.endFrame = scene.range[1];
        this.syncRange();
    }

    pickShot(event) {
        const dataset = event && event.currentTarget ? event.currentTarget.dataset : null;
        const shot = this.shots.find((item) => item.id === (dataset ? dataset.shot : ""));
        if (!shot) return;
        this.evidence = null;
        if (!shot.range) {
            this.error = `镜头 ${shot.id} 引用的场景 ${shot.scene} 不在工程里。`;
            return;
        }
        this.error = "";
        this.startFrame = shot.range[0];
        this.endFrame = shot.range[1];
        this.syncRange();
    }

    pickPanel(event) {
        const dataset = event && event.currentTarget ? event.currentTarget.dataset : null;
        const shot = this.shots.find((item) => item.id === (dataset ? dataset.shot : ""));
        if (!shot) return;
        const panel = shot.panels.find((item) => item.id === (dataset ? dataset.panel : ""));
        if (!panel) return;
        if (!panel.absolute) {
            this.error = `面板 ${panel.id} 没有可渲染的绝对区间：镜头 ${shot.id} 的场景 ${shot.scene} 不在工程里。`;
            return;
        }
        this.error = "";
        this.startFrame = panel.absolute[0];
        this.endFrame = panel.absolute[1];
        this.syncRange();
        const cues = this.cues.filter((cue) => cue.shot === shot.id && cue.absolute && cue.absolute[0] < panel.absolute[1] && cue.absolute[1] > panel.absolute[0]);
        this.evidence = {
            shotId: shot.id,
            panelId: panel.id,
            range: panel.absolute,
            purpose: panel.purpose,
            composition: panel.composition,
            dialogue: panel.dialogue,
            camera: panel.camera,
            sound: panel.sound,
            notes: panel.notes,
            cues,
        };
        this.statusText = `已定位面板 ${panel.id}`;
    }

    playEvidence() {
        if (!this.evidence || !this.evidence.range) return;
        this.startFrame = this.evidence.range[0];
        this.endFrame = this.evidence.range[1];
        this.syncRange();
        this.renderRange();
    }

    wholeFilm() {
        if (!this.session) return;
        this.startFrame = 0;
        this.endFrame = this.session.project.durationFrames;
        this.syncRange();
    }

    renderRange() {
        if (!this.session || !this.bridgeReady) return;
        const duration = this.session.project.durationFrames;
        this.startFrame = Math.max(0, Math.min(duration, Math.round(this.startFrame)));
        this.endFrame = Math.max(0, Math.min(duration, Math.round(this.endFrame)));
        if (this.endFrame <= this.startFrame) {
            this.error = "结束帧必须大于起始帧。";
            return;
        }
        this.error = "";
        this.rendering = true;
        this.progressDone = 0;
        this.progressTotal = this.endFrame - this.startFrame;
        this.progressStyle = "width: 0%";
        this.syncRange();
        this.statusText = "正在渲染区间…";
        this.post({
            type: "preview.range",
            startFrame: this.startFrame,
            endFrame: this.endFrame,
            scale: this.scale,
        });
    }

    formatBytes(bytes) {
        const value = Number(bytes) || 0;
        if (value >= 1024 * 1024) return `${(value / (1024 * 1024)).toFixed(1)} MiB`;
        return `${Math.max(1, Math.round(value / 1024))} KiB`;
    }
}
</script>
