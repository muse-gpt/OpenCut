    color: var(--oc-muted);
}

.pill {
    padding: 2px 8px;
    border: 1px solid var(--oc-line);
    border-radius: 999px;
    background: var(--oc-surface-2);
    color: var(--oc-muted);
    font-size: 11px;
    white-space: nowrap;
}

.spacer {
    flex: 1;
}

.status {
    color: #1e7a45;
    font-size: 12px;
}

.status.bad {
    color: var(--oc-danger);
}

.banner {
    flex: 0 0 auto;
    padding: 10px 16px;
    border-bottom: 1px solid #f0d6a8;
    background: #fff8e8;
    color: #7a5a12;
}

.banner.bad {
    border-color: #f2c4bd;
    background: #fdf0ee;
    color: var(--oc-danger);
}

.banner code {
    padding: 1px 5px;
    border-radius: 4px;
    background: rgba(0, 0, 0, 0.06);
}

.wb-body {
    display: flex;
    flex: 1 1 auto;
    min-height: 0;
}

.rail {
    flex: 0 0 15rem;
    padding: 14px 12px 24px;
    border-right: 1px solid var(--oc-line);
    background: var(--oc-surface);
    overflow-y: auto;
}

.rail h2 {
    margin: 0 0 8px;
    color: var(--oc-muted);
    font-size: 11px;
    font-weight: 600;
    letter-spacing: 0.12em;
    text-transform: uppercase;
}

.rail h2 + h2 {
    margin-top: 20px;
}

.scene {
    display: flex;
    width: 100%;
    align-items: baseline;
    justify-content: space-between;
    gap: 8px;
    margin: 0 0 4px;
    padding: 6px 8px;
    border: 1px solid transparent;
    border-radius: 6px;
    background: transparent;
    color: var(--oc-ink);
    text-align: left;
}

